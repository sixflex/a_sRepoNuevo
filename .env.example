# Configuración general de Django
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True

# Configuración del Servicio Transversal de Correo (Coordinación A+S)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=coordinacion.as@uautonoma.cl
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_aqui
DEFAULT_FROM_EMAIL=Coordinación A+S <coordinacion.as@uautonoma.cl>

# Carta de Presentación: planilla Word oficial del Coordinador (fuera del repositorio).
# Se toman de ella el logo, la firma y la tarjeta. Ej.: C:\Privado\carta_oficial.docx
CARTA_PLANTILLA_PATH=

# Ingreso con Microsoft (guía: CONECTAR_MICROSOFT.md)
# ENTRA_MODO: simulado (demo) | microsoft (real) | desactivado. Vacío = simulado con DEBUG, desactivado sin DEBUG.
ENTRA_MODO=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Correos que siempre entran como Coordinador, separados por coma.
COORDINADORES=
# Llave para cifrar la clave del correo de envío (Configuración → Correo de envío). Vacía = se deriva de SECRET_KEY.
CORREO_CLAVE_CIFRADO=
